# ─── Server ───────────────────────────────────────────
PORT=3000

# ─── JWT ──────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# ─── Admin credentials (change before deploying!) ─────
ADMIN_EMAIL=admin@projectrestaurant.local
ADMIN_PASSWORD=ProjectRestaurantAdmin2024!

# ─── Email (SMTP) ─────────────────────────────────────
# For Gmail: use an App Password (not your real password)
# https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Project Restaurant <your-email@gmail.com>"
EMAIL_REPLY_TO=hello@projectrestaurant.local

# ─── Restaurant info ──────────────────────────────────
RESTAURANT_NAME=Project Restaurant
RESTAURANT_EMAIL=hello@projectrestaurant.local

# ─── CORS ─────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500
